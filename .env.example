# Copie este arquivo para ".env.local" (desenvolvimento) e/ou ".env"
# (produção/remoto). Nenhum dos dois deve ser commitado — ambos já estão no
# .gitignore. Na Vercel, essas mesmas variáveis também precisam ser
# cadastradas em Project Settings → Environment Variables.

# ---------------------------------------------------------------------------
# Sessão do admin
# ---------------------------------------------------------------------------
# Segredo usado para assinar o JWT do cookie de sessão do admin.
# Gere um valor aleatório forte, ex: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-bem-grande-e-aleatorio

# Chave usada uma única vez para criar o primeiro usuário admin via
# POST /api/auth/setup. Depois de criar o admin, pode trocar/remover.
ADMIN_SETUP_KEY=troque-por-outra-chave-aleatoria

# ---------------------------------------------------------------------------
# Banco de dados (Turso / libSQL)
# ---------------------------------------------------------------------------
# Para desenvolvimento local sem precisar de conta Turso, aponte pra um
# arquivo SQLite local:
#   TURSO_DATABASE_URL=file:./local.db
# (nesse caso TURSO_AUTH_TOKEN pode ficar vazio)
#
# Para produção, crie o banco com `turso db create doceria-db` e pegue a URL
# com `turso db show doceria-db --url` e o token com
# `turso db tokens create doceria-db`.
TURSO_DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Armazenamento de imagens (Cloudflare R2, via endpoint compatível com S3)
# ---------------------------------------------------------------------------
# Crie um bucket R2 no dashboard da Cloudflare e um API Token de R2 em
# Cloudflare Dashboard → R2 → Manage R2 API Tokens.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=doceria-imagens
